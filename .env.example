# Opcional: o docker-compose.yml já tem esses valores como padrão (${VAR:-...}), então
# `docker compose up --build` funciona sem este arquivo. Copie para .env na raiz do projeto
# (docker compose lê ./.env automaticamente) só se quiser sobrescrever algum valor.
# Exemplos para avaliação local; não são credenciais de produção.
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminpassword
POSTGRES_DB=findb
# Use o serviço db e a porta INTERNA 5432. Deve corresponder aos valores acima.
# Caracteres especiais no usuário/senha precisam de percent-encoding nesta URL.
DATABASE_URL=postgresql://admin:adminpassword@db:5432/findb
JWT_SECRET=local-development-only-change-me
PLUGGY_MOCK=1
API_PORT=3333
FRONTEND_PORT=8080
DB_PORT=5433
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
VITE_API_URL=http://localhost:3333
