# PLUGGY_MOCK=1   # opcional: stub local sem credenciais/rede
# Intervalo do sync automático em horas (default 6; 0 desliga; ignorado em modo mock)
# SYNC_INTERVAL_HOURS="6"
# URL pública deste backend p/ receber webhooks da Pluggy/MeuPluggy (registrada no connect-token)
