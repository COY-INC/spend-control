# Postgres — já aponta para o banco do docker-compose.yml da raiz (porta 5433 no host)
DATABASE_URL="postgresql://admin:adminpassword@localhost:5433/findb"
# Porta da API (vazio = 3333; na nuvem, ex. Railway, a plataforma injeta a sua via PORT)
PORT=""
# Origens do frontend liberadas no CORS, separadas por vírgula (vazio = http://localhost:5173)
CORS_ORIGIN=""
# Segredo dos tokens JWT — valor apenas para desenvolvimento; use um valor forte em produção
JWT_SECRET="dev-secret-troque"
# 1 = stub local da Pluggy, sem credenciais nem rede. Remova para usar a Pluggy real.
PLUGGY_MOCK=1
# Credenciais Pluggy (Open Finance) — só necessárias sem PLUGGY_MOCK
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
# Intervalo do sync automático em horas (default 6; 0 desliga; ignorado em modo mock)
# SYNC_INTERVAL_HOURS="6"
# URL pública deste backend p/ receber webhooks da Pluggy (só com Pluggy real)
WEBHOOK_URL=""
